   1 	Q0 	 1 	PNSM 	NC3 	 1 	1.0 	
   2 	Qa 	 1 	PNSM 	PO4 	 2 	-1.0 	
   3 	P1 	 1 	PNSM 	AM1 	 3 	0 	
   4 	P5 	 1 	PNSM 	AM2 	 4 	0 	
   5 	C3 	 1 	PNSM 	T1A 	 5 	0 	
   6 	C1 	 1 	PNSM 	C2A 	 6 	0 	
   7 	C1 	 1 	PNSM 	C3A 	 7 	0 	
   8 	C1 	 1 	PNSM 	C1B 	 8 	0 	
   9 	C1 	 1 	PNSM 	C2B 	 9 	0 	
  10 	C1 	 1 	PNSM 	C3B 	10 	0 	
  11 	C3 	 1 	PNSM 	D4B 	11 	0 	
  12 	C1 	 1 	PNSM 	C5B 	12 	0 	
  13 	C1 	 1 	PNSM 	C6B 	13 	0 	

[bonds]
;  i  j 	funct 	length 	force.c.
   1  2 	1 	0.47 	1250 	
   2  3 	1 	0.47 	1250 	
   3  4 	1 	0.37 	1250 	
   3  5 	1 	0.47 	1250 	
   5  6 	1 	0.47 	1250 	
   6  7 	1 	0.47 	1250 	
   4  8 	1 	0.47 	1250 	
