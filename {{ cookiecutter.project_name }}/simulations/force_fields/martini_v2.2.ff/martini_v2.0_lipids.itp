; file martini_v2.0_PVDG_01.itp
;;;;;; Martini lipid topology for C16:0/18:1 DAG (PVDG), generated using:
; The Martini lipid itp generator version 0.6  Args are: -o martini_v2.0_PVDG_01.itp -alname PVDG -alhead '' -allink 'G G' -altail 'CCDC CCCC'
; WARNING: Lipids topology was generated following the Martini 2.0 guidelines but this specific lipid type might
;          not have been tested and should therefore be used with care. 
;
; Description:
;   A general model diacylglycerol (DAG) lipid corresponding to atomistic e.g. C16:1(11c), C18:1(11c), C18:1(12c) tails.
; Parameterization:
;   This topology follows the standard Martini 2.0 lipid definitions and building block rules.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   T.A. Wassenaar, H.I. Ingolfsson, R.A. Bockmann, D.P. Tieleman, S.J. Marrink. Computational lipidomics with insane: a versatile 
;   tool for generating custom membranes for molecular simulations. JCTC, 150410125128004, 2015. doi:10.1021/acs.jctc.5b00209
; Created: 2015.04.20
; Warning(s)/Note(s):
;   Note, 2016.09.27, GL1 bead type changed from Na to P1 to better represent GL1 with a added OH group
;
;@INSANE alhead=, allink=G G, altail=CCDC CCCC, alname=PVDG, charge=0
;@RESNTEST PVD==PVDG if: atoms[0]==GL1
;@BEADS GL1 GL2 C1A C2A D3A C4A C1B C2B C3B C4B 
;@BONDS GL1-GL2 GL1-C1A C1A-C2A C2A-D3A D3A-C4A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

[moleculetype]
; molname      nrexcl
  PVDG          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge
   1 	P1 	 1 	PVDG 	GL1 	 1 	0 	; bead type changed to P1 to account for the added OH group (mod. 2016.09.27)
   2 	Na 	 1 	PVDG 	GL2 	 2 	0 	
   3 	C1 	 1 	PVDG 	C1A 	 3 	0 	
   4 	C1 	 1 	PVDG 	C2A 	 4 	0 	
   5 	C3 	 1 	PVDG 	D3A 	 5 	0 	
   6 	C1 	 1 	PVDG 	C4A 	 6 	0 	
   7 	C1 	 1 	PVDG 	C1B 	 7 	0 	
   8 	C1 	 1 	PVDG 	C2B 	 8 	0 	
   9 	C1 	 1 	PVDG 	C3B 	 9 	0 	
  10 	C1 	 1 	PVDG 	C4B 	10 	0 	

[bonds]
;  i  j 	funct 	length 	force.c.
   1  2 	1 	0.37 	1250 	
   1  3 	1 	0.47 	1250 	
   3  4 	1 	0.47 	1250 	
   4  5 	1 	0.47 	1250 	
   5  6 	1 	0.47 	1250 	
   2  7 	1 	0.47 	1250 	
   7  8 	1 	0.47 	1250 	
   8  9 	1 	0.47 	1250 	
   9 10 	1 	0.47 	1250 	

[angles]
;  i  j  k 	funct 	angle 	force.c.
   1  3  4 	2 	180.0 	25.0 	
   3  4  5 	2 	180.0 	25.0 	
   4  5  6 	2 	120.0 	45.0 	
   2  7  8 	2 	180.0 	25.0 	
   7  8  9 	2 	180.0 	25.0 	
   8  9 10 	2 	180.0 	25.0 	


; file martini_v2.0_PVP1_01.itp
;;;;;; Martini lipid topology for C16:0/18:1 PIP (PVP1), generated using:
; The Martini lipid itp generator version 0.4  Args are: -o martini_v2.0_PVP1_01.itp -alname PVP1 -alhead 'P1' -allink 'G G' -altail 'CCDC CCCC'
; WARNING: Lipids topology was generated following the Martini 2.0 guidelines but this specific lipid type might
;          not have been tested and should therefore be used with care. 
;
; Description:
;   A general model phosphatidylinositol phosphate (PIP) lipid corresponding to atomistic e.g. C16:1(11c), C18:1(11c), 
;   C18:1(12c) tails.
; Parameterization:
;   The lipid head is based on atomistic phosphatidilinositol 3-mono-phosphate (PIP(3)) simulations, see 
;   Lopez et al. 2013 for details. The lipid tail follows the standard Martini 2.0 lipid definitions and 
;   building block rules.
; Reference(s): 
;   C.A. Lopez, Z. Sovova, F.J. van Eerden, A.H. de Vries, S.J. Marrink. Martini force field parameters for glycolipids. JCTC, 
;   9:1694-1708, 2013. doi:10.1021/ct3009655 
;   H.I. Ingolfsson, M.N. Melo, F.J. van Eerden, C. Arnarez, C.A. Lopez, T.A. Wassenaar, X. Periole, A.H. De Vries, D.P. Tieleman, 
;   S.J. Marrink. Lipid organization of the plasma membrane. JACS, 136:14554-14559, 2014. doi:10.1021/ja507832e 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f
; Created: 2015.04.20
; Author(s): Cesar Lopez <C.A.Lopez-Bautista@rug.nl>
; Modified:
;   Helgi I. Ingolfsson <h.i.ingolfsson@rug.nl> and Xavier Periole <x.periole@rug.nl>, 2014.06. 
;   Removed dihedral to increase stability.
; Warning(s)/Note(s):
;   Warning, dihedral for head oriantation was removed to make the molecule more stable - this should be 
;   better tested and compaired to atomistic simulations. 
;   Note, in this topology the phosphates are unprotonated. At pH 7, some of the phosphates can have one or even two 
;   protonations, reducing the molecules total charge. 
;   Node, bonds with force constant > 25000 are treated as constraints, but use harmonic bonds for minimization. 
;   Add define=-DFLEXIBLE to .mdp options to select harmonic bonds for minimization purposes.
;
;@INSANE alhead=P1, allink=G G, altail=CCDC CCCC, alname=PVP1, charge=-3.0
;@RESNTEST PVP==PVP1 if: atoms[0]==C1  and atoms[4]==P1
;@BEADS C1 C2 C3 PO4 P1 GL1 GL2 C1A C2A D3A C4A C1B C2B C3B C4B 
;@BONDS C1-C2 C1-C3 C2-C3 C1-P1 C2-P1 C1-PO4 PO4-GL1 GL1-GL2 GL1-C1A C1A-C2A C2A-D3A D3A-C4A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

[moleculetype]
; molname      nrexcl
  PVP1          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge
   1 	P1 	 1 	PVP1 	C1  	 1 	0 	
   2 	P1 	 1 	PVP1 	C2  	 2 	0 	; corrected particle type (P1 instead of Na), oct 2013
   3 	P4 	 1 	PVP1 	C3  	 3 	0 	
   4 	Qa 	 1 	PVP1 	PO4 	 4 	-1.0 	; Name changed from CP to PO4
   5 	Qa 	 1 	PVP1 	P1  	 5 	-2.0 	
; Tail part (uses standar Martini v2.0 tail rules)
   6 	Na 	 1 	PVP1 	GL1 	 6 	0 	
   7 	Na 	 1 	PVP1 	GL2 	 7 	0 	
   8 	C1 	 1 	PVP1 	C1A 	 8 	0 	
   9 	C1 	 1 	PVP1 	C2A 	 9 	0 	
  10 	C3 	 1 	PVP1 	D3A 	10 	0 	
