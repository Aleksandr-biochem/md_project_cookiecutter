;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f
; 

[ moleculetype ]
; molname      nrexcl
  ACN         1

[ atoms ]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge   mass
  1 	Qa 	1 	ACN 	COO 	1      -1 
  2 	C4 	1 	ACN 	D1  	2 	0 
  3 	C4 	1 	ACN 	D2  	3 	0 
  4 	C4 	1 	ACN 	D3  	4 	0 
  5 	C4 	1 	ACN 	D4  	5 	0
  6 	C1 	1 	ACN 	C5  	6 	0  

[ bonds ]
; i j 	funct 	length 	force.c.
