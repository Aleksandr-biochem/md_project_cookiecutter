;;;;;; Martini lipid topology for C18:3/16:0 SQDG (FPSG)
;
; Description:
;  Sulfoquinovosyldiacylglycerol (SQDG) with an α-linolenoyl tail at sn1 and a palmitoyl chain at sn2, as present in the 
;  thylakoid membrane of Spinacia oleracea (spinach). Corresponding to atomistic e.g. C18:3(9c,12c,15c)/16:0 SQDG.
; Keywords: thylakoid, plant
; Parameterization:
;  This topology follows the standard Martini 2.0 lipid definitions and building block rules.
;  NOTE, there are modficiations from the parameters as described in Lopez et al. 2013, see Van Eerden et al. 2015
;  for the modifications.
; Reference(s): 
;  S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;  2004. doi:10.1021/jp036508g                                                                      
;  S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;  biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;  C.A. Lopez, Z. Sovova, F.J. van Eerden, A.H. de Vries, S.J. Marrink. Martini force field parameters for glycolipids.
;  JCTC, 9:1694-1708, 2013. doi:10.1021/ct3009655
;  F.J. van Eerden, D.H. de Jong, A.H. de Vries, T.A. Wassenaar, S.J. Marrink. Characterization of thylakoid lipid membranes from
;  cyanobacteria and higher plants by molecular dynamics simulations. BBA - Biomembranes, 1848, 1319-1330, 2015. 
;  doi:10.1016/j.bbamem.2015.02.025
; Created: 2015.05.27
;

[ moleculetype ]
 FPSG     1

[ atoms ]
     1 Qa          1 FPSG  S1     1              -1         72
     2 P4          1 FPSG  C1     2               0         72
     3 N0          1 FPSG  C2     3               0         72
     4 P1          1 FPSG  C3     4               0         72
     5 Na          1 FPSG  GL1    5               0         72
     6 Na          1 FPSG  GL2    6               0         72
     7 C1          1 FPSG  C1A    7               0         72
     8 C1          1 FPSG  C2A    8               0         72
     9 C1          1 FPSG  C3A    9               0         72
    10 C1          1 FPSG  C4A    10              0         72
    11 C1          1 FPSG  C1B    11              0         72
    12 C4          1 FPSG  D2B    12              0         72
    13 C4          1 FPSG  D3B    13              0         72
    14 C4          1 FPSG  D4B    14              0         72

[ bonds ]
; i j funct length force.c.
     1     3     1  0.262 30000 
     2     3     1   0.3 30000
     2     4     1   0.3 30000
     3     4     1   0.3 30000
     4     5     1 0.426 30000
     5     6     1  0.37  1250
     5     7     1  0.47  1250
     7     8     1  0.47  1250
     8     9     1  0.47  1250
     9    10     1  0.47  1250
     6    11     1  0.47  1250
    11    12     1  0.47  1250
    12    13     1  0.47  1250
    13    14     1  0.47  1250

[ angles ]
; i j k funct angle force.c.
     1     3     2     2 150.0  20.0
     1     3     4     2 145.0  20.0
     2     4     5     2 140.0  35.0
     3     4     5     2 100.0  35.0
     4     5     6     2  85.0  20.0
     4     5     7     2 131.0  25.0
     5     7     8     2 180.0  25.0
     7     8     9     2 180.0  25.0
     8     9    10     2 180.0  25.0
     6    11    12     2 180.0  25.0 ;from  DFPC
    11    12    13     2 100.0  10.0 ;from  DFPC
    12    13    14     2 100.0  10.0 ;from  DFPC

[ dihedrals ]
     2     4     5     6     1  30.0   8.0     1

; file martini_v2.0_HBHT_01.itp
;;; Martini topology for bacteriohopanetetrol.
;
; Description:
;   A Martini model for bacteriohopanetetrol using virtual sites. 
; Parameterization:
;   Constructed by appending the polyol chain to the topology of the hopanoid polycyclic moiety; see Melo 2015. Based on
;   GROMOS 54a7 distributions (see Poger 2013).
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   D. Poger and A.E. Mark. The relative effect of sterols and hopanoids on lipid bilayers: when comparable is not identical.
;   JPC-B, 117:16129-16140, 2013. doi:10.1021/jp409748d
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2014.05
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% hopanoid membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[ moleculetype ]
; molname  nrexcl
  HBHT     1

[ atoms ]
; i type resnr residue atom cgnr charge mass
  1  SC2  1     HBHT    R1   1    0.0     92.0
  2  SC2  1     HBHT    R2   2    0.0      0.0
  3  SC2  1     HBHT    R3   3    0.0      0.0 
  4  SC2  1     HBHT    R4   4    0.0     72.0 
  5  SC2  1     HBHT    R5   5    0.0    134.0
  6  SC2  1     HBHT    R6   6    0.0      0.0
  7  SC2  1     HBHT    R7   7    0.0      0.0
  8  SC2  1     HBHT    R8   8    0.0     72.0
  9   C1  1     HBHT    C1   9    0.0     72.0
 10   P2  1     HBHT    C2  10    0.0     72.0
 11   P2  1     HBHT    C3  11    0.0     72.0

[ bonds ]
; i  j  funct  length  force
  8  9    1     0.334  15000.0  
  9  10   1     0.368   8000.0
  10 11   1     0.267  15000.0
#ifdef FLEXIBLE
  1  4  1   0.4010  1000000 
  1  5  1   0.5998  1000000 
  4  5  1   0.3294  1000000 
  4  8  1   0.6036  1000000 
  5  8  1   0.3605  1000000 
#else
[ constraints ]
; i  j  funct  length
  1  4  1   0.4010   
  1  5  1   0.5998   
  4  5  1   0.3294   
  4  8  1   0.6036   
  5  8  1   0.3605   
#endif

[ angles ]
  7  8  9  2    81.0  700.0
  8  9 10  2   130.0  50.0
  8  9 10  10  130.0  25.0
  9 10 11  2   170.0  40.0

[ dihedrals ]
  6  7  8  9   1   25.0 200.0  1
  7  8  9 10   1  -80.0  20.0  1
; The frame's stiff hinge
  1 4 5 8     2  164.0 250

[ virtual_sites3 ]
; OUT-OF-PLANE BEADS from the 1,4,5 frame (beads 2 and 3)
  2  4 1 5  4   0.6083  -0.4646   0.4904 
  3  4 1 5  4   0.2649   0.2202  -1.0061
; OUT-OF-PLANE BEADS from the 8,4,5 frame (beads 6 and 7)
  6  5 8 4  4   0.3090   0.2071   1.8175 
  7  5 8 4  4   0.9888   0.7502   1.4303

[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7  8
  2  3  4  5  6  7  8
  3  4  5  6  7  8
  4  5  6  7  8
  5  6  7  8
  6  7  8
  7  8  9

; file martini_v2.0_HDPT_01.itp
;;; Martini topology for diploptene.
;
; Description:
;   A Martini model for diploptene using virtual sites. 
; Parameterization:
;   Constructed by appending the propenyl chain to the topology of the hopanoid polycyclic moiety; see Melo 2015. Based on
;   GROMOS 54a7 distributions (see Poger 2013).
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   D. Poger and A.E. Mark. The relative effect of sterols and hopanoids on lipid bilayers: when comparable is not identical.
;   JPC-B, 117:16129-16140, 2013. doi:10.1021/jp409748d
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2014.05
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% hopanoid membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[ moleculetype ]
; molname  nrexcl
  HDPT     1

[ atoms ]
; i type resnr residue atom cgnr charge mass
  1  SC2  1    HDPT    R1   1    0.0     92.0
  2  SC2  1    HDPT    R2   2    0.0      0.0
  3  SC2  1    HDPT    R3   3    0.0      0.0 
  4  SC2  1    HDPT    R4   4    0.0     72.0 
  5  SC2  1    HDPT    R5   5    0.0    134.0
  6  SC2  1    HDPT    R6   6    0.0      0.0
  7  SC2  1    HDPT    R7   7    0.0      0.0
  8  SC2  1    HDPT    R8   8    0.0     72.0
  9   C3  1    HDPT    C1   9    0.0     72.0

[ bonds ]
; i  j  funct  length  force
  8   9   1     0.303  20000.0
#ifdef FLEXIBLE
  1  4  1   0.4010  1000000 
  1  5  1   0.5998  1000000 
  4  5  1   0.3294  1000000 
  4  8  1   0.6036  1000000 
  5  8  1   0.3605  1000000 
#else
[ constraints ]
; i  j  funct  length
  1  4  1   0.4010   
  1  5  1   0.5998   
  4  5  1   0.3294   
  4  8  1   0.6036   
  5  8  1   0.3605   
#endif

[ virtual_sites3 ]
; OUT-OF-PLANE BEADS from the 1,4,5 frame (beads 2 and 3)
  2  4 1 5  4   0.6083  -0.4646   0.4904 
  3  4 1 5  4   0.2649   0.2202  -1.0061
; OUT-OF-PLANE BEADS from the 8,4,5 frame (beads 6 and 7)
  6  5 8 4  4   0.3090   0.2071   1.8175 
  7  5 8 4  4   0.9888   0.7502   1.4303

[ angles ]
  7  8  9   2   75.5  700

[ dihedrals ]
  6  7  8  9   1  18.0 160.0  1
; The frame's stiff hinge
  1 4 5 8     2  164.0 250

[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7  8
  2  3  4  5  6  7  8
  3  4  5  6  7  8
  4  5  6  7  8
  5  6  7  8
  6  7  8
  7  8  9

