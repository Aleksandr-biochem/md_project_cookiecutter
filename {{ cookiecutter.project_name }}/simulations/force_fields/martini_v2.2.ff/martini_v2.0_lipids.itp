; file martini_v2.0_C12E2.itp
;;;;;; Martini lipid topology for C12E2
;
; Description:
;   A Martini model of a alkyl-PEG surfactant, here called C12E2.
; Parameterization:
;   See Grunewald et al., J. Phys. Chem B. 2018
; Reference(s): 
;   F. Grunewald, G. Rossi, A.H. De Vries, S.J. Marrink, L. Monticelli. A Transferable MARTINI Model of Polyethylene Oxide. 
;   JPCB, 2018, online. doi:10.1021/acs.jpcb.8b04760
; Warning(s)/Note(s):
; - The model makes use of a special bead type called EO. For the most part EO has been verified to work
;   well with the other MARTINI 2 beads especially in the context of the model for this molecule.
;

[ moleculetype ]
;name     exclusions
C12E2      1

[ atoms ]
;id   type   resnr  residu   atom   cgnr   charg
  1    C1       1    C12E2    C1      1   0.0000000
  2    C1       1    C12E2    C2      2   0.0000000
  3    C1       1    C12E2    C3      3   0.0000000
  4    EO       1    C12E2   PEO1     4   0.0000000
  5    EO       1    C12E2   PEO2     5   0.0000000
  6   SP2       1    C12E2   C2OH     6   0.0000000

[ bonds ]
 ;i   j   funct   length      force c.
  1   2   1       0.4700000   1250.00000000
  2   3   1       0.4700000   1250.00000000
  3   4   1       0.4100000   5000.00000000
  4   5   1       0.3220000   7000.00000000
  5   6   1       0.2800000   7000.00000000

[ angles ]
;i j k   funct   angle   force c.
  1   2   3   2     180.00000000     25.00000000
  2   3   4   2     180.00000000     25.00000000
  3   4   5   2     180.00000000     25.00000000
  4   5   6   2     140.00000000     25.00000000


