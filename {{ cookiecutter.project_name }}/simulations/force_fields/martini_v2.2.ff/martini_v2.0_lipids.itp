; file martini_v2.0_HOPR_01.itp
;;; Martini topology for the hopanoid polycyclic moiety.
;
; Description:
;   A Martini model for the polycyclic group of hopanoids using virtual sites. 
; Parameterization:
;   From GROMOS 54a7 distributions (see Poger 2013), to have 4 virtual sites. See Melo 2015.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   D. Poger and A.E. Mark. The relative effect of sterols and hopanoids on lipid bilayers: when comparable is not identical.
;   JPC-B, 117:16129-16140, 2013. doi:10.1021/jp409748d
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2014.05
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% hopanoid membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[ moleculetype ]
; molname  nrexcl
  HOPR     1

[ atoms ]
; i type resnr residue atom cgnr charge mass
  1  SC2  1    HOPR    R1   1    0.0     92.0
  2  SC2  1    HOPR    R2   2    0.0      0.0
  3  SC2  1    HOPR    R3   3    0.0      0.0 
  4  SC2  1    HOPR    R4   4    0.0     72.0 
  5  SC2  1    HOPR    R5   5    0.0    134.0
  6  SC2  1    HOPR    R6   6    0.0      0.0
  7  SC2  1    HOPR    R7   7    0.0      0.0
  8  SC2  1    HOPR    R8   8    0.0     72.0

[ dihedrals ]
  1 4 5 8     2  164.0 250

#ifdef FLEXIBLE
[ bonds ]
; i  j  funct  length
  1  4  1   0.4010  1000000 
  1  5  1   0.5998  1000000 
  4  5  1   0.3294  1000000 
  4  8  1   0.6036  1000000 
  5  8  1   0.3605  1000000 
#else
[ constraints ]
; i  j  funct  length
  1  4  1   0.4010   
  1  5  1   0.5998   
  4  5  1   0.3294   
  4  8  1   0.6036   
  5  8  1   0.3605   
#endif

[ virtual_sites3 ]
; OUT-OF-PLANE BEADS from the 1,4,5 frame (beads 2 and 3)
  2  4 1 5  4   0.6083  -0.4646   0.4904 
  3  4 1 5  4   0.2649   0.2202  -1.0061
; OUT-OF-PLANE BEADS from the 8,4,5 frame (beads 6 and 7)
  6  5 8 4  4   0.3090   0.2071   1.8175 
  7  5 8 4  4   0.9888   0.7502   1.4303

[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7  8
  2  3  4  5  6  7  8
  3  4  5  6  7  8
  4  5  6  7  8
  5  6  7  8
  6  7  8
  7  8

; file martini_v2.0_IPC_01.itp
;;;;;; Martini lipid topology for C16:2-C18:2 LPC (IPC), generated using:
; The Martini lipid itp generator version 0.4  Args are: -o martini_v2.0_IPC_01.itp -alname IPC -alhead 'C P' -allink 'G G' -altail '- CDDC'
; WARNING: Lipids topology was generated following the Martini 2.0 guidelines but this specific lipid type might
;          not have been tested and should therefore be used with care. 
;
; Description:
;   A general model lysophosphatidylcholine (LPC) lipid corresponding to atomistic e.g. C18:2(9c,12c) linoleic acid tails.
; Parameterization:
;   This topology follows the standard Martini 2.0 lipid definitions and building block rules.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   T.A. Wassenaar, H.I. Ingolfsson, R.A. Bockmann, D.P. Tieleman, S.J. Marrink. Computational lipidomics with insane: a versatile 
;   tool for generating custom membranes for molecular simulations. JCTC, 150410125128004, 2015. doi:10.1021/acs.jctc.5b00209
; Created: 2015.04.20
;
;@INSANE alhead=C P, allink=G G, altail=- CDDC, alname=IPC, charge=0.0
;@RESNTEST IPC==IPC if: atoms[0]==NC3
;@BEADS NC3 PO4 GL1 GL2 C1B D2B D3B C4B 
;@BONDS NC3-PO4 PO4-GL1 GL1-GL2 GL2-C1B C1B-D2B D2B-D3B D3B-C4B 
;

[moleculetype]
; molname      nrexcl
  IPC          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge
   1 	Q0 	 1 	IPC 	NC3 	 1 	1.0 	
   2 	Qa 	 1 	IPC 	PO4 	 2 	-1.0 	
   3 	P1 	 1 	IPC 	GL1 	 3 	0 	
   4 	Na 	 1 	IPC 	GL2 	 4 	0 	
   5 	C1 	 1 	IPC 	C1B 	 5 	0 	
   6 	C4 	 1 	IPC 	D2B 	 6 	0 	
   7 	C4 	 1 	IPC 	D3B 	 7 	0 	
   8 	C1 	 1 	IPC 	C4B 	 8 	0 	

[bonds]
;  i  j 	funct 	length 	force.c.
   1  2 	1 	0.47 	1250 	
   2  3 	1 	0.47 	1250 	
   3  4 	1 	0.37 	1250 	
   4  5 	1 	0.47 	1250 	
   5  6 	1 	0.47 	1250 	
   6  7 	1 	0.47 	1250 	
   7  8 	1 	0.47 	1250 	

[angles]
;  i  j  k 	funct 	angle 	force.c.
   2  3  4 	2 	180.0 	25.0 	
   3  4  5 	2 	180.0 	25.0 	
   4  5  6 	2 	180.0 	25.0 	
   5  6  7 	2 	100.0 	10.0 	
   6  7  8 	2 	120.0 	45.0 	


; file martini_v2.0_JFPG_01.itp
;;;;;; Martini lipid topology for C16:1(3t)/18:3 PG (JFPG)
;
; Description:
;  Phosphatidylglycerol (PG), with a trans-3-hexadecenoic acid tail (sn1) and an α-linolenoyl tail (sn2), as present in the 
