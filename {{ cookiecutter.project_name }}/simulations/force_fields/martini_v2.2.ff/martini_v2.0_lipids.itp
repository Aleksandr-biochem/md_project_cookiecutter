; file martini_v2.0_CHOA_02.itp
;;;;;; Martini lipid topology for cholate
;
; Description:
;   A Martini model for cholate (3a-7a-12a-trihydroxy-5b-cholanoate).
; Parameterization:
;   Adaptation of the existing cholate topology to the virtual site topology developed for cholesterol. See Marrink 2004 and Melo 2015.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   S.J. Marrink. Molecular dynamics simulations of cholesterol nucleation in mixed micelles modelling human bile.
;   Proceedings of Falk Symposium 139, G.Adler et al Eds., Kluwer Academic Publishers, Dordrecht, Chapter 13, pp98-105, 2004.
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2015.12
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% cholesterol membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[moleculetype]
; molname 	nrexcl
  CHOA 		1
                                                                                
[atoms]
; i type resnr residue atom cgnr charge mass
  1 SP1  1 	   CHOA    ROH  1     0.0   77.22
  2 SC1  1 	   CHOA    R1   2     0.0     0.0
  3 SC3  1 	   CHOA    R2   3     0.0   38.69
  4 SP1  1 	   CHOA    RO2  4     0.0  159.65
  5 SP1  1 	   CHOA    RO3  5     0.0     0.0
  6 SC1  1 	   CHOA    R3   6     0.0     0.0
  7 SC1  1 	   CHOA    C1   7     0.0   39.44
  8 Qa   1 	   CHOA    OCO  8    -1.0    72.0

[ bonds ]
; i  j  funct  length  force
  7  8  1      0.425   1250.0
#ifdef FLEXIBLE
  1  3  1    0.4904  1000000 
  1  4  1    0.6019  1000000
  3  4  1    0.2719  1000000 
  7  3  1    0.7237  1000000
  7  4  1    0.5376  1000000
#else
[ constraints ]
  1  3  1    0.4904  
  1  4  1    0.6019 
  3  4  1    0.2719  
  7  3  1    0.7237 
  7  4  1    0.5376 
#endif

[ dihedrals ]
  1  3  4  7   2  -179.7  50

[ virtual_sites3 ]
; In-plane bead from frame 4-3-7 (bead 5)
  5  4  3  7   1  0.9613  0.6320 
; Out-of-plane bead from frame 3-1-4 (bead 2)
  2  3  1  4   4  0.5207  0.2882  -0.83824 
; Out-of-plane bead from frame 4-3-7 (bead 6)
  6  4  3  7   4  0.2287  0.4111   1.1531 

[ angles ]
; i  j  k  funct  angle  force
  4  7  8  2      180.0  25.0

[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7
  2  3  4  5  6  7
  3  4  5  6  7
  4  5  6  7
  5  6  7
  6  7

; file martini_v2.0_CHOL_02.itp
;;;;;; Martini lipid topology for cholesterol
;
; Description:
;   A Martini model for cholesterol. An alternative topology for cholesterol using virtual sites. 
; Parameterization:
;   Adapted from the equilibrium structure of Martini 2.0 cholesterol (Marrink et al. 2008) to have 3 virtual sites, 
;   see Melo et al. 2015. Frame masses were distributed to best mimic the original cholesterol's moment of inertia 
;   (using S-particle mass of 45). The off-plane bead distance was increased by 30% to reduce the propensity of cholesterol 
;   to self-associate, and therefore to more effectively disrupt lipid chain packing in lo-domains.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   S.J. Marrink, A.H. de Vries, T.A. Harroun, J. Katsaras, S.R. Wassall. Cholesterol shows preference for the interior of 
;   polyunsaturated lipid membranes. JACS, 130:10-11, 2008. doi:10.1021/ja076641c
;   H.I. Ingolfsson, M.N. Melo, F.J. van Eerden, C. Arnarez, C.A. Lopez, T.A. Wassenaar, X. Periole, A.H. De Vries, D.P. Tieleman,
;   S.J. Marrink. Lipid organization of the plasma membrane. JACS, 136:14554-14559, 2014. doi:10.1021/ja507832e
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2014.05
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% cholesterol membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[ moleculetype ]
; molname  nrexcl
  CHOL     1

[ atoms ]
; i type resnr residue atom cgnr charge mass
  1 SP1  1     CHOL    ROH  1    0.0    77.22
  2 SC1  1     CHOL    R1   2    0.0      0.0
  3 SC3  1     CHOL    R2   3    0.0    38.69
  4 SC1  1     CHOL    R3   4    0.0   159.65
  5 SC1  1     CHOL    R4   5    0.0      0.0
  6 SC1  1     CHOL    R5   6    0.0      0.0
  7 SC1  1     CHOL    C1   7    0.0    39.44
  8  C1  1     CHOL    C2   8    0.0     72.0

[ bonds ]
; i  j  funct  length  force
  7  8  1      0.425   1250.0
#ifdef FLEXIBLE
  1  3  1    0.4904  1000000 
  1  4  1    0.6019  1000000
  3  4  1    0.2719  1000000 
  7  3  1    0.7237  1000000
  7  4  1    0.5376  1000000
#else
[ constraints ]
  1  3  1    0.4904  
  1  4  1    0.6019 
  3  4  1    0.2719  
  7  3  1    0.7237 
  7  4  1    0.5376 
#endif

[ dihedrals ]
  1  3  4  7   2  -179.7  50

[ virtual_sites3 ]
; In-plane bead from frame 4-3-7 (bead 5)
  5  4  3  7   1  0.9613  0.6320 
; Out-of-plane bead from frame 3-1-4 (bead 2)
  2  3  1  4   4  0.5207  0.2882  -0.83824 
; Out-of-plane bead from frame 4-3-7 (bead 6)
  6  4  3  7   4  0.2287  0.4111   1.1531 

[ angles ]
; i  j  k  funct  angle  force
  4  7  8  2      180.0  25.0

[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7
  2  3  4  5  6  7
  3  4  5  6  7
  4  5  6  7
  5  6  7
  6  7

; file martini_v2.0_CHYO_02.itp
;;;;;; Martini lipid topology for cholesteryl oleate
;
; Description:
;   A Martini model for cholesteryl oleate.
; Parameterization:
;   Adaptation of the existing topology (provided by Timu Vuorela, see Vuorela et al. 2010) to the virtual site topology
;   developed for cholesterol. See Melo 2015.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   T. Vuorela, A. Catte, P.S. Niemela, A. Hall, M.T. Hyvonen, S.J. Marrink, M. Karttunen, I. Vattulainen. Role of lipids in 
;   spheroidal high density lipoproteins. PLOS comp bio, 2010. doi:10.1371/journal.pcbi.1000964
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2015.12
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% cholesterol membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[ moleculetype ]
; molname       nrexcl
CHYO               1
                                                                                
[ atoms ]
; i type resnr residue atom cgnr charge mass
  1 SC1  1     CHYO    R0   1    0.0    77.22
  2 SC1  1     CHYO    R1   2    0.0      0.0
  3 SC3  1     CHYO    R2   3    0.0    38.69
  4 SC1  1     CHYO    R3   4    0.0   159.65
  5 SC1  1     CHYO    R4   5    0.0      0.0
  6 SC1  1     CHYO    R5   6    0.0      0.0
  7 SC1  1     CHYO    C1   7    0.0    39.44
  8 C1   1     CHYO    C2   8    0.0     72.0
  9 Na   1     CHYO    ES   9    0.0     72.0   
 10 C1   1     CHYO    C3  10    0.0     72.0   
 11 C3   1     CHYO    C4  11    0.0     72.0
 12 C1   1     CHYO    C5  12    0.0     72.0
 13 C1   1     CHYO    C6  13    0.0     72.0
                                                                                 
[ bonds ]
; i  j  funct  length  force
  7  8  1      0.425   1250.0
  1  9  1      0.470   1250.0
  9 10  1      0.470   1250.0
 10 11  1      0.470   1250.0
 11 12  1      0.470   1250.0
 12 13  1      0.470   1250.0
#ifdef FLEXIBLE
  1  3  1    0.4904  1000000 
  1  4  1    0.6019  1000000
  3  4  1    0.2719  1000000 
  7  3  1    0.7237  1000000
  7  4  1    0.5376  1000000
#else
[ constraints ]
  1  3  1    0.4904  
  1  4  1    0.6019 
  3  4  1    0.2719  
  7  3  1    0.7237 
  7  4  1    0.5376 
#endif

[ dihedrals ]
  1  3  4  7   2  -179.7  50

[ virtual_sites3 ]
; In-plane bead from frame 4-3-7 (bead 5)
  5  4  3  7   1  0.9613  0.6320 
; Out-of-plane bead from frame 3-1-4 (bead 2)
  2  3  1  4   4  0.5207  0.2882  -0.83824 
; Out-of-plane bead from frame 4-3-7 (bead 6)
  6  4  3  7   4  0.2287  0.4111   1.1531 

[angles]
;  i     j    k     funct   angle  force.c.
   4     7    8       2  180.000     25.0
   1     9   10       2  180.000     25.0
   9    10   11       2  180.000     25.0
  10    11   12       2  120.000     45.0
  11    12   13       2  180.000     25.0
                                                                                
[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7
  2  3  4  5  6  7
  3  4  5  6  7
  4  5  6  7
  5  6  7
  6  7

; file martini_v2.0_CPC_01.itp
;;;;;; Martini lipid topology for C04:0-C06:0 LPC (CPC), generated using:
; The Martini lipid itp generator version 0.4  Args are: -o martini_v2.0_CPC_01.itp -alname CPC -alhead 'C P' -allink 'G G' -altail '- C'
; WARNING: Lipids topology was generated following the Martini 2.0 guidelines but this specific lipid type might
;          not have been tested and should therefore be used with care. 
;
; Description:
;   A general model lysophosphatidylcholine (LPC) lipid corresponding to atomistic C04:0 butyryl - C06:0 hexanoyl tails.
; Parameterization:
;   This topology follows the standard Martini 2.0 lipid definitions and building block rules.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   T.A. Wassenaar, H.I. Ingolfsson, R.A. Bockmann, D.P. Tieleman, S.J. Marrink. Computational lipidomics with insane: a versatile 
;   tool for generating custom membranes for molecular simulations. JCTC, 150410125128004, 2015. doi:10.1021/acs.jctc.5b00209
; Created: 2015.04.20
;
;@INSANE alhead=C P, allink=G G, altail=- C, alname=CPC, charge=0.0
;@RESNTEST CPC==CPC if: atoms[0]==NC3
;@BEADS NC3 PO4 GL1 GL2 C1B 
;@BONDS NC3-PO4 PO4-GL1 GL1-GL2 GL2-C1B 
;

[moleculetype]
; molname      nrexcl
  CPC          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge
   1 	Q0 	 1 	CPC 	NC3 	 1 	1.0 	
   2 	Qa 	 1 	CPC 	PO4 	 2 	-1.0 	
   3 	P1 	 1 	CPC 	GL1 	 3 	0 	
   4 	Na 	 1 	CPC 	GL2 	 4 	0 	
   5 	C1 	 1 	CPC 	C1B 	 5 	0 	

[bonds]
;  i  j 	funct 	length 	force.c.
   1  2 	1 	0.47 	1250 	
   2  3 	1 	0.47 	1250 	
   3  4 	1 	0.37 	1250 	
   4  5 	1 	0.47 	1250 	

[angles]
;  i  j  k 	funct 	angle 	force.c.
   2  3  4 	2 	180.0 	25.0 	
   3  4  5 	2 	180.0 	25.0 	


; file martini_v2.0_DAPA_01.itp
;;;;;; Martini lipid topology for di-C20:4-C22:5 PA (DAPA), generated using:
; The Martini lipid itp generator version 0.4  Args are: -o martini_v2.0_DAPA_01.itp -alname DAPA -alhead 'O' -allink 'G G' -altail 'DDDDC DDDDC'
; WARNING: Lipids topology was generated following the Martini 2.0 guidelines but this specific lipid type might
;          not have been tested and should therefore be used with care. 
;
; Description:
;   A general model phosphatidic acid (PA) lipid corresponding to atomistic e.g. C20:4(5c,8c,11c,14c) di-arachidonic acid (AA), 
;   - C22:5(4c,7c,10c,13c,16c) docosapentaenoic acid tails.
; Parameterization:
;   This topology follows the standard Martini 2.0 lipid definitions and building block rules.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
