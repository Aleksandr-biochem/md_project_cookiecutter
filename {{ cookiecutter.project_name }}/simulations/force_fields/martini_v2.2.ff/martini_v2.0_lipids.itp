   1 	P5 	 1 	PUPS 	CNO 	 1 	0.0 	
   2 	Qa 	 1 	PUPS 	PO4 	 2 	-1.0 	
   3 	Na 	 1 	PUPS 	GL1 	 3 	0 	
   4 	Na 	 1 	PUPS 	GL2 	 4 	0 	
   5 	C4 	 1 	PUPS 	D1A 	 5 	0 	
