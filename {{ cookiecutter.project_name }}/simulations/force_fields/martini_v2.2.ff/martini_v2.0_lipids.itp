 16 18  1      mb_cc
 18 19  1      mb_cc
 19 20  1      mb_cc
 20 21  1      mb_cc
 21 22  1      mb_cc
 17 23  1      mb_cc
 23 24  1      mb_cc
 24 25  1      mb_cc
 25 26  1      mb_cc
 26 27  1      mb_cc

[ angles ]
; i  j  k  funct  alias
  2  1 15  2      ma_pgp ; linking bead: PO41-GL5-PO42
  1  2  3  2      ma_gpg ; linking bead to first glycerol group:  PO41-GL5-PO42
  1 15 16  2      ma_gpg ; linking bead to second glycerol group: PO41-GL5-PO42
  2  3  4  2      ma_pgg
  2  3  5  2      ma_pgc
  3  5  6  2      ma_gcc
  5  6  7  2      ma_ccc
