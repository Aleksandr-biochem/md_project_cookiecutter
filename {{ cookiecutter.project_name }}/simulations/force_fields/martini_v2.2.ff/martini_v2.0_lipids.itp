; file martini_v2.0_ACA_01.itp
;;;;;; Martini lipid topology for arachidonic (C20:4) / docosapentaenoic (C22:5) acid
;
; Description:
;   A general carboxylic acid Martini model for arachidonic (C20:4) or docosapentaenoic (C22:5) acid with protonated (uncharged) headgroup.
; Parameterization:
;   Follows similar rules as the standard Martini 2.0 lipid definitions but with a P4 bead as headgroup.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f
; 

[ moleculetype ]
; molname      nrexcl
  ACA         1

[ atoms ]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge   mass
  1 	P4 	1 	ACA 	COO 	1 	0 
  2 	C4 	1 	ACA 	D1  	2 	0 
  3 	C4 	1 	ACA 	D2  	3 	0 
  4 	C4 	1 	ACA 	D3  	4 	0 
  5 	C4 	1 	ACA 	D4  	5 	0 
  6 	C1 	1 	ACA 	C5  	6 	0 

[ bonds ]
; i j 	funct 	length 	force.c.
  1  2 	1 	0.47 	1250
  2  3 	1 	0.47 	1250
  3  4 	1 	0.47 	1250
  4  5 	1 	0.47 	1250
  5  6 	1 	0.47 	1250

[ angles ]
; i j k 	funct 	angle 	force.c.
  1  2  3 	2 	100.0 	10.0 
  2  3  4 	2 	100.0 	10.0 
  3  4  5 	2 	100.0 	10.0 
  4  5  6 	2 	120.0 	45.0 

; file martini_v2.0_ACN_01.itp
;;;;;; Martini lipid topology for arachidonic (C20:4) / docosapentaenoic (C22:5) acid
