  11 	C1 	 1 	PUPS 	C2B 	11 	0 	
  12 	C1 	 1 	PUPS 	C3B 	12 	0 	
  13 	C1 	 1 	PUPS 	C4B 	13 	0 	

[bonds]
;  i  j 	funct 	length 	force.c.
   1  2 	1 	0.47 	1250 	
   2  3 	1 	0.47 	1250 	
